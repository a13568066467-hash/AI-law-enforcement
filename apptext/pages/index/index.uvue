<template>

	<view class="page">

		<text class="h1">AI 实地相机</text>

		<text class="sub">胸牌 AI 相机 · BLE 网关 · 零配置登录</text>



		<view class="card">

			<text class="label">相机连接</text>

			<text class="value">{{ statusText }}</text>

		</view>



		<view class="card">

			<text class="label">账号</text>

			<text class="value">{{ loginText }}</text>

		</view>



		<button class="btn primary" type="primary" @click="onConnect">连接相机</button>

		<button class="btn" @click="onDisconnect">断开</button>



		<view class="row">

			<button class="btn half" @click="onStartRec">开始录像</button>

			<button class="btn half" @click="onStopRec">停止录像</button>

		</view>



		<view class="card">

			<text class="hint">充电时 BLE FLAGS bit0=1 · 见 docs/边充边录.md</text>

		</view>

	</view>

</template>



<script setup lang="uts">

	import * as session from '../../services/session.uts'



	const statusText = ref('未连接')

	const loginText = ref('未登录')

	let pollTimer : number = 0



	function refresh() {

		statusText.value = session.getBleSummary()

		loginText.value = session.getLoginSummary()

	}



	function onConnect() {

		session.connectCamera((ok, msg) => {

			refresh()

			if (!ok) {

				uni.showToast({ title: msg, icon: 'none' })

			}

		})

	}



	function onDisconnect() {

		session.disconnectCamera()

		refresh()

		uni.showToast({ title: '已断开', icon: 'none' })

	}



	function onStartRec() {

		if (!session.startRecord()) {

			uni.showToast({ title: '请先连接相机', icon: 'none' })

		}

	}



	function onStopRec() {

		session.stopRecord()

	}



	onShow(() => {

		session.onStatusChanged(refresh)

		refresh()

		pollTimer = setInterval(() => {

			refresh()

		}, 2000)

	})



	onHide(() => {

		if (pollTimer != 0) {

			clearInterval(pollTimer)

			pollTimer = 0

		}

	})

</script>



<style>

	.page {

		padding: 24px;

		flex-direction: column;

	}



	.h1 {

		font-size: 22px;

		font-weight: bold;

		color: #1a1a1a;

		margin-bottom: 8px;

	}



	.sub {

		font-size: 14px;

		color: #666;

		margin-bottom: 24px;

	}



	.card {

		background-color: #fff;

		border-radius: 8px;

		padding: 16px;

		margin-bottom: 16px;

	}



	.label {

		font-size: 12px;

		color: #888;

		margin-bottom: 4px;

	}



	.value {

		font-size: 16px;

		color: #333;

	}



	.hint {

		font-size: 12px;

		color: #999;

		line-height: 18px;

	}



	.btn {

		margin-bottom: 12px;

	}



	.primary {

		background-color: #1a5fb4;

	}



	.row {

		flex-direction: row;

		justify-content: space-between;

		margin-bottom: 12px;

	}



	.half {

		width: 48%;

	}

</style>

