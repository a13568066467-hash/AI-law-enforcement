<template>

	<view class="page">

		<text class="status">{{ bleText }}</text>

		<text v-if="items.length == 0" class="empty">暂无照片 · 连接相机后按快门或点下方按钮</text>

		<scroll-view v-else class="list" scroll-y="true">

			<view v-for="item in items" :key="item.id" class="card">

				<image class="thumb" :src="'data:image/jpeg;base64,' + item.base64" mode="aspectFit" />

				<text class="meta">{{ formatSize(item.size) }} · {{ formatTime(item.createdAt) }}</text>

				<text class="explain">{{ item.explanation.length > 0 ? item.explanation : '识图中…' }}</text>

			</view>

		</scroll-view>

		<button type="primary" @click="onCapture">远程快门（CMD 0x03）</button>

	</view>

</template>



<script setup lang="uts">

	import * as session from '../../services/session.uts'



	const items = ref<session.AlbumItem[]>([])

	const bleText = ref('')



	function refresh() {

		items.value = session.getAlbumItems()

		bleText.value = session.getBleSummary()

	}



	function formatSize(n : number) : string {

		if (n < 1024) {

			return n.toString() + ' B'

		}

		return (n / 1024).toFixed(1) + ' KB'

	}



	function formatTime(ts : number) : string {

		const d = new Date(ts)
		const h = d.getHours()
		const m = d.getMinutes()
		const hs = h < 10 ? '0' + h.toString() : h.toString()
		const ms = m < 10 ? '0' + m.toString() : m.toString()
		return hs + ':' + ms
	}



	function onCapture() {

		if (!session.triggerCapture()) {

			uni.showToast({ title: '请先连接相机', icon: 'none' })

			return

		}

		uni.showToast({ title: '已发送拍照命令', icon: 'none' })

	}



	onShow(() => {

		session.onAlbumChanged(refresh)

		session.onStatusChanged(refresh)

		refresh()

	})

</script>



<style>

	.page {

		padding: 16px;

		flex-direction: column;

		flex: 1;

	}



	.status {

		font-size: 13px;

		color: #1a5fb4;

		margin-bottom: 12px;

	}



	.empty {

		font-size: 16px;

		color: #666;

		margin-bottom: 16px;

	}



	.list {

		flex: 1;

		height: 500px;

		margin-bottom: 12px;

	}



	.card {

		margin-bottom: 16px;

		padding: 12px;

		background-color: #fff;

		border-radius: 8px;

	}



	.thumb {

		width: 100%;

		height: 200px;

		margin-bottom: 8px;

	}



	.meta {

		font-size: 12px;

		color: #888;

		margin-bottom: 6px;

	}



	.explain {

		font-size: 14px;

		color: #333;

		line-height: 20px;

	}

</style>

