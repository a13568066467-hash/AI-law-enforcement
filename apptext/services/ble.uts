import {
	BLE_DEVICE_NAME_PREFIX,
	BLE_SERVICE_UUID,
	CHR_CMD_WRITE,
	CHR_CMD_NOTIFY,
	CHR_IMAGE_TX,
	CHR_SENSOR_NOTIFY,
	EVT_CAPTURE_DONE,
} from '../common/config.uts'

export type BleConnState = 'idle' | 'scanning' | 'connected' | 'error'
export type ImageReceivedHandler = (base64 : string, size : number) => void
export type BleStatusHandler = () => void
export type BleCmdEventHandler = (evtId : number, payload : ArrayBuffer) => void

let connState : BleConnState = 'idle'
let connectedDeviceId : string = ''
let lastError : string = ''
let batteryPercent : number = -1
let deviceState : number = 0
let sensorFlags : number = 0

let serviceIdBle : string = ''
let charCmdWriteId : string = ''

let pendingImageSize : number = 0
let imageHandler : ImageReceivedHandler | null = null
let statusHandler : BleStatusHandler | null = null
let cmdEventHandler : BleCmdEventHandler | null = null

const imageBuffers = new Map<number, Uint8Array>()
const imageTotals = new Map<number, number>()
const imageReceived = new Map<number, Set<number>>()

export const SENSOR_FLAG_CHARGING = 0x01

/** 提取 16bit UUID 后缀，兼容 Android 多种格式 */
export function uuidSuffix(uuid : string) : string {
	const u = uuid.toUpperCase().replace(/-/g, '')
	if (u.length >= 8) {
		return u.substring(4, 8)
	}
	return u
}

export function charIdMatches(candidateId : string, suffix : string) : boolean {
	return uuidSuffix(candidateId) == suffix.toUpperCase()
}

export function getConnState() : BleConnState {
	return connState
}

export function getConnectedDeviceId() : string {
	return connectedDeviceId
}

export function getLastError() : string {
	return lastError
}

export function getBatteryPercent() : number {
	return batteryPercent
}

export function getDeviceFsmState() : number {
	return deviceState
}

export function isCharging() : boolean {
	return (sensorFlags & SENSOR_FLAG_CHARGING) != 0
}

export function setOnImageReceived(handler : ImageReceivedHandler | null) {
	imageHandler = handler
}

export function setOnStatusChanged(handler : BleStatusHandler | null) {
	statusHandler = handler
}

export function setOnCmdEvent(handler : BleCmdEventHandler | null) {
	cmdEventHandler = handler
}

function notifyStatusChanged() {
	statusHandler?.invoke()
}

function resetImageAssembly() {
	imageBuffers.clear()
	imageTotals.clear()
	imageReceived.clear()
	pendingImageSize = 0
}

function findCharId(res : GetBLEDeviceCharacteristicsSuccess, uuid : string) : string {
	const want = uuidSuffix(uuid)
	const list = res.characteristics
	for (let i = 0; i < list.length; i++) {
		const c = list[i]
		if (charIdMatches(c.uuid, want)) {
			return c.characteristicId
		}
	}
	return ''
}

function enableNotify(deviceId : string, serviceId : string, charId : string, name : string, onDone : () => void) {
	if (charId.length == 0) {
		onDone()
		return
	}
	uni.notifyBLECharacteristicValueChange({
		deviceId: deviceId,
		serviceId: serviceId,
		characteristicId: charId,
		state: true,
		success: (_res) => {
			console.log('notify on', name)
			onDone()
		},
		fail: (err) => {
			console.log('notify fail', name, err.errMsg)
			onDone()
		},
	})
}

function setupNotifications(deviceId : string, serviceId : string) {
	uni.getBLEDeviceCharacteristics({
		deviceId: deviceId,
		serviceId: serviceId,
		success: (res) => {
			charCmdWriteId = findCharId(res, CHR_CMD_WRITE)
			const cmdNotify = findCharId(res, CHR_CMD_NOTIFY)
			const imageTx = findCharId(res, CHR_IMAGE_TX)
			const sensor = findCharId(res, CHR_SENSOR_NOTIFY)
			enableNotify(deviceId, serviceId, cmdNotify, 'CMD_NOTIFY', () => {
				enableNotify(deviceId, serviceId, imageTx, 'IMAGE_TX', () => {
					enableNotify(deviceId, serviceId, sensor, 'SENSOR', () => {})
				})
			})
		},
		fail: (err) => {
			lastError = err.errMsg ?? 'get characteristics failed'
		},
	})
}

function onConnected(deviceId : string, onDone : (ok : boolean, msg : string) => void) {
	connectedDeviceId = deviceId
	connState = 'connected'
	uni.stopBluetoothDevicesDiscovery({ complete: () => {} })

	uni.getBLEDeviceServices({
		deviceId: deviceId,
		success: (res) => {
			let svcId = ''
			for (let i = 0; i < res.services.length; i++) {
				const s = res.services[i]
				if (charIdMatches(s.uuid, 'A001')) {
					svcId = s.uuid
					break
				}
			}
			if (svcId.length == 0) {
				onDone(false, '未找到 A001 服务')
				return
			}
			serviceIdBle = svcId
			setupNotifications(deviceId, svcId)
			notifyStatusChanged()
			onDone(true, '已连接 ' + BLE_DEVICE_NAME_PREFIX)
		},
		fail: (err) => {
			onDone(false, err.errMsg ?? 'get services failed')
		},
	})
}

function tryConnect(deviceId : string, onDone : (ok : boolean, msg : string) => void) {
	uni.createBLEConnection({
		deviceId: deviceId,
		success: (_res) => {
			setTimeout(() => {
				onConnected(deviceId, onDone)
			}, 400)
		},
		fail: (err) => {
			connState = 'error'
			lastError = err.errMsg ?? 'connect failed'
			onDone(false, lastError)
		},
	})
}

function handleSensorNotify(value : ArrayBuffer) {
	const v = new DataView(value)
	if (value.byteLength >= 3) {
		const prev = deviceState
		batteryPercent = v.getUint8(0)
		deviceState = v.getUint8(1)
		sensorFlags = v.getUint8(2)
		if (prev != deviceState) {
			notifyStatusChanged()
		}
	}
}

function arrayBufferToBase64(buffer : ArrayBuffer) : string {
	const bytes = new Uint8Array(buffer)
	let binary = ''
	for (let i = 0; i < bytes.length; i++) {
		binary += String.fromCharCode(bytes[i])
	}
	// @ts-ignore
	if (typeof btoa != 'undefined') {
		return btoa(binary)
	}
	return uni.arrayBufferToBase64(buffer)
}

function tryFinishImage(msgId : number) {
	const total = imageTotals.get(msgId)
	const buf = imageBuffers.get(msgId)
	const got = imageReceived.get(msgId)
	if (total == null || buf == null || got == null) {
		return
	}
	if (got.size < total) {
		return
	}
	const outLen = pendingImageSize > 0 ? pendingImageSize : buf.length
	const slice = buf.slice(0, outLen)
	const b64 = arrayBufferToBase64(slice.buffer as ArrayBuffer)
	imageHandler?.invoke(b64, outLen)
	imageBuffers.delete(msgId)
	imageTotals.delete(msgId)
	imageReceived.delete(msgId)
}

function handleCmdNotify(value : ArrayBuffer) {
	const v = new DataView(value)
	if (value.byteLength < 1) {
		return
	}
	const evt = v.getUint8(0)
	cmdEventHandler?.invoke(evt, value)
	if (evt == EVT_CAPTURE_DONE) {
		resetImageAssembly()
		if (value.byteLength >= 5) {
			pendingImageSize = v.getUint32(1, false)
		}
	}
}

function handleImageChunk(value : ArrayBuffer) {
	const v = new DataView(value)
	if (value.byteLength < 6) {
		return
	}
	const msgId = v.getUint16(0, false)
	const seq = v.getUint16(2, false)
	const total = v.getUint16(4, false)
	const dataLen = value.byteLength - 6

	if (!imageTotals.has(msgId)) {
		const cap = pendingImageSize > 0 ? pendingImageSize : total * 512
		imageTotals.set(msgId, total)
		imageBuffers.set(msgId, new Uint8Array(cap))
		imageReceived.set(msgId, new Set<number>())
	}

	const buf = imageBuffers.get(msgId)
	const got = imageReceived.get(msgId)
	if (buf == null || got == null) {
		return
	}
	const offset = seq * 512
	const chunk = new Uint8Array(value, 6, dataLen)
	buf.set(chunk, offset)
	got.add(seq)
	tryFinishImage(msgId)
}

let listenerRegistered = false

function ensureValueListener() {
	if (listenerRegistered) {
		return
	}
	listenerRegistered = true
	uni.onBLECharacteristicValueChange((res) => {
		const cid = res.characteristicId
		if (charIdMatches(cid, 'A008')) {
			handleSensorNotify(res.value)
		} else if (charIdMatches(cid, 'A006')) {
			handleImageChunk(res.value)
		} else if (charIdMatches(cid, 'A003')) {
			handleCmdNotify(res.value)
		}
	})
}

export function startConnect(onDone : (ok : boolean, msg : string) => void) {
	lastError = ''
	connState = 'scanning'
	resetImageAssembly()
	ensureValueListener()

	uni.openBluetoothAdapter({
		success: (_res) => {
			uni.onBluetoothDeviceFound((found) => {
				const devs = found.devices
				for (let i = 0; i < devs.length; i++) {
					const d = devs[i]
					const name = d.name ?? d.localName ?? ''
					if (name.indexOf(BLE_DEVICE_NAME_PREFIX) >= 0) {
						uni.stopBluetoothDevicesDiscovery({ complete: () => {} })
						tryConnect(d.deviceId, onDone)
						return
					}
				}
			})
			uni.startBluetoothDevicesDiscovery({
				allowDuplicatesKey: false,
				success: (_res2) => {
					setTimeout(() => {
						if (connState == 'scanning') {
							connState = 'idle'
							onDone(false, '未找到 ' + BLE_DEVICE_NAME_PREFIX + '，请确认固件已烧录')
						}
					}, 12000)
				},
				fail: (err) => {
					connState = 'error'
					lastError = err.errMsg ?? 'startDiscovery failed'
					onDone(false, lastError)
				},
			})
		},
		fail: (err) => {
			connState = 'error'
			lastError = err.errMsg ?? 'openBluetoothAdapter failed'
			onDone(false, lastError)
		},
	})
}

export function disconnect() {
	if (connectedDeviceId.length > 0) {
		uni.closeBLEConnection({
			deviceId: connectedDeviceId,
			complete: () => {},
		})
	}
	uni.stopBluetoothDevicesDiscovery({ complete: () => {} })
	connectedDeviceId = ''
	connState = 'idle'
	batteryPercent = -1
	deviceState = 0
	serviceIdBle = ''
	charCmdWriteId = ''
	notifyStatusChanged()
}

export function writeCmd(cmdId : number, payload : number[] | null) : boolean {
	if (connectedDeviceId.length == 0 || charCmdWriteId.length == 0 || serviceIdBle.length == 0) {
		lastError = '未连接或 GATT 未就绪'
		return false
	}
	const pl = payload ?? []
	const len = pl.length
	const buf = new ArrayBuffer(3 + len)
	const view = new DataView(buf)
	view.setUint8(0, cmdId)
	view.setUint16(1, len, false)
	for (let i = 0; i < len; i++) {
		view.setUint8(3 + i, pl[i])
	}
	uni.writeBLECharacteristicValue({
		deviceId: connectedDeviceId,
		serviceId: serviceIdBle,
		characteristicId: charCmdWriteId,
		value: buf,
		fail: (err) => {
			console.log('writeCmd fail', err.errMsg)
			lastError = err.errMsg ?? 'writeCmd failed'
		},
	})
	return true
}
