# Agnes AI OpenAI 兼容接口
DASHSCOPE_API_KEY=sk-xxxxxxxx
DASHSCOPE_BASE_URL=https://apihub.agnes-ai.com/v1

CHAT_MODEL=agnes-2.0-flash
VISION_MODEL=agnes-2.0-flash

# 开发用 JWT 密钥
JWT_SECRET=dev-change-me

# 巡查员档案：默认 SQLite（backend/data/officers.db）
# OFFICER_DB_PATH=/var/lib/aifieldcam/officers.db

# 切换为 MySQL 时取消注释并填写（OFFICER_DB_DRIVER=mysql）
# OFFICER_DB_DRIVER=mysql
# MYSQL_HOST=127.0.0.1
# MYSQL_PORT=3306
# MYSQL_USER=root
# MYSQL_PASSWORD=your_password
# MYSQL_DATABASE=aifieldcam

# ── 人脸验证（YOLO 检测 + SFace 识别）────────────────────────────
# 引擎：auto | yolo | opencv | insightface | legacy
#   auto   → 优先 YOLO+SFace，其次 InsightFace，再 OpenCV YuNet+SFace
#   yolo   → YOLOv8-face 检测 + SFace 128维特征（推荐室外/多人场景）
#   opencv → YuNet 检测 + SFace（依赖少，无需 ultralytics）
PATROL_FACE_ENGINE=auto

# SFace / YOLO+SFace 余弦相似度通过线（默认 0.36；室外可试 0.32）
PATROL_FACE_MATCH_THRESHOLD=0.36

# YOLO 检测置信度（0.1~0.95，默认 0.4）
PATROL_YOLO_CONF=0.4

# YOLO 人脸框扩边比例（默认 0.25，略大更利于 SFace 对齐）
PATROL_YOLO_FACE_PADDING=0.25

# 可选：自定义 YOLO 模型路径或下载 URL（默认 backend/models/face/yolov8n-face-lindevs.pt）
# PATROL_YOLO_MODEL=D:/models/yolov8n-face-lindevs.pt
# PATROL_YOLO_MODEL_URL=https://github.com/lindevs/yolov8-face/releases/download/1.0.0/yolov8n-face-lindevs.pt

# 仅 legacy 模式：解析失败时用占位向量（正式环境请设为 0）
PATROL_DEMO_RELAX_FACE=0
